# Loaded by shairport-sync only (skills/music/airplay.js starts it with HOME set to this folder).
# Plays AirPlay as before (MediaOut) and tees a copy to beat-relay.py so Jibo can dance to the beat.
pcm.airplay_beat {
    type file
    slave.pcm "MediaOut"
    file "/tmp/jibo-airplay-beat"  # a FIFO that beat-relay.py (started by airplay.js) reads
    format "raw"
}
