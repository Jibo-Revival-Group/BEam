			"prompt_id": "FC_WhatsYourName_01",
			"weight": 1
		},
		{
			"prompt_category": "Entry-Core",
			"prompt_sub_category": "AN",
			"index": 1,
			"condition": "",
			"prompt": "I haven't met anybody here yet. <pitch mult='1.1'>So,</pitch> what's your name?",
			"media": "TTS",
			"prompt_id": "FC_WhatsYourName_02",
			"weight": 1
		}
